{
    "name": "Better YT UI",
    "description": "Better YouTube UI",
    "version": "0.4.0",
    "icons": {
        "128": "icon.png"
    },
    "manifest_version": 3,
    "permissions": [
        "storage"
    ],
    "action": {
        "default_title": "Better YT UI",
        "default_popup": "options.html"
    },
    "options_ui": {
        "page": "options.html"
    },
    "content_scripts": [
        {
            "css": [
                "main.css"
            ],
            "js": [
                "shared.js",
                "content.js"
            ],
            "matches": [
                "https://www.youtube.com/*"
            ],
            "run_at": "document_start"
        }
    ]
}